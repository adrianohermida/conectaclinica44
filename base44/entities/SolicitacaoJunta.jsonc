{
  "name": "SolicitacaoJunta",
  "type": "object",
  "properties": {
    "tipo_documento": {
      "type": "string",
      "enum": [
        "contrato_social",
        "alteracao_contratual",
        "certidao_simplificada",
        "ficha_cadastral",
        "ata_assembleia"
      ],
      "description": "Tipo de documento solicitado"
    },
    "numero_protocolo": {
      "type": "string",
      "description": "N\u00famero do protocolo na Junta"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "junta_comercial": {
      "type": "string",
      "description": "Junta Comercial (ex: JUCEA)"
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "data_solicitacao": {
      "type": "string",
      "format": "date",
      "description": "Data da solicita\u00e7\u00e3o"
    },
    "prazo_estimado": {
      "type": "number",
      "description": "Prazo estimado em dias"
    },
    "data_prevista_entrega": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de entrega"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_andamento",
        "aguardando_pagamento",
        "concluido",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pela solicita\u00e7\u00e3o"
    },
    "custo_estimado": {
      "type": "string",
      "description": "Custo estimado"
    },
    "custo_real": {
      "type": "number",
      "description": "Custo real"
    },
    "portal_url": {
      "type": "string",
      "description": "URL do portal da Junta"
    },
    "instrucoes": {
      "type": "string",
      "description": "Instru\u00e7\u00f5es detalhadas"
    },
    "documentos_necessarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Documentos necess\u00e1rios"
    },
    "historico": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string"
          },
          "acao": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de a\u00e7\u00f5es"
    },
    "documento_id": {
      "type": "string",
      "description": "ID do documento societ\u00e1rio gerado"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "tipo_documento",
    "cnpj",
    "estado"
  ]
}