{
  "name": "MovimentacaoEstoque",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica (multi-tenant)"
    },
    "medicamento_id": {
      "type": "string",
      "description": "ID do medicamento"
    },
    "medicamento_nome": {
      "type": "string",
      "description": "Nome do medicamento"
    },
    "tipo_movimentacao": {
      "type": "string",
      "enum": [
        "entrada",
        "saida",
        "ajuste"
      ],
      "description": "Tipo de movimenta\u00e7\u00e3o"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade movimentada"
    },
    "data_movimentacao": {
      "type": "string",
      "format": "date",
      "description": "Data da movimenta\u00e7\u00e3o"
    },
    "estoque_anterior": {
      "type": "number",
      "description": "Estoque antes"
    },
    "estoque_atual": {
      "type": "number",
      "description": "Estoque depois"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel"
    }
  },
  "required": [
    "clinica_id",
    "medicamento_id",
    "tipo_movimentacao",
    "quantidade"
  ],
  "indexes": [
    {
      "fields": [
        "clinica_id",
        "-created_date"
      ],
      "name": "idx_movimentacao_timeline_optimized"
    },
    {
      "fields": [
        "clinica_id",
        "medicamento_id",
        "-data_movimentacao"
      ],
      "name": "idx_movimentacao_medicamento"
    },
    {
      "fields": [
        "clinica_id",
        "tipo_movimentacao",
        "-data_movimentacao"
      ],
      "name": "idx_movimentacao_tipo"
    }
  ]
}