{
  "name": "Blog",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do artigo"
    },
    "slug": {
      "type": "string",
      "description": "URL amig\u00e1vel"
    },
    "resumo": {
      "type": "string",
      "description": "Resumo/excerpt"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado completo (markdown)"
    },
    "imagem_capa": {
      "type": "string",
      "description": "URL da imagem de capa"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "tecnologia",
        "medicina",
        "gestao",
        "ia",
        "telemedicina",
        "lgpd",
        "tutorial"
      ],
      "default": "gestao",
      "description": "Categoria do artigo"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags do artigo"
    },
    "autor": {
      "type": "string",
      "description": "Nome do autor"
    },
    "autor_cargo": {
      "type": "string",
      "description": "Cargo do autor"
    },
    "autor_avatar": {
      "type": "string",
      "description": "URL avatar do autor"
    },
    "publicado": {
      "type": "boolean",
      "default": false,
      "description": "Artigo publicado?"
    },
    "data_publicacao": {
      "type": "string",
      "format": "date",
      "description": "Data de publica\u00e7\u00e3o"
    },
    "visualizacoes": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de visualiza\u00e7\u00f5es"
    }
  },
  "required": [
    "titulo",
    "slug",
    "conteudo",
    "autor"
  ]
}