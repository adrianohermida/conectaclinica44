{
  "name": "DadosFiscaisClinica",
  "type": "object",
  "properties": {
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social da cl\u00ednica"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ"
    },
    "inscricao_estadual": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Estadual"
    },
    "inscricao_municipal": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Municipal"
    },
    "endereco_completo": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "cep": {
      "type": "string",
      "description": "CEP"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "E-mail"
    },
    "regime_tributario": {
      "type": "string",
      "enum": [
        "simples_nacional",
        "lucro_presumido",
        "lucro_real",
        "mei"
      ],
      "description": "Regime tribut\u00e1rio"
    },
    "data_abertura": {
      "type": "string",
      "format": "date",
      "description": "Data de abertura"
    },
    "cnae_principal": {
      "type": "string",
      "description": "CNAE principal"
    },
    "cnaes_secundarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CNAEs secund\u00e1rios"
    },
    "capital_social": {
      "type": "number",
      "description": "Capital social"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "razao_social",
    "cnpj"
  ]
}