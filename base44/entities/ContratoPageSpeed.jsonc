{
  "name": "ContratoPageSpeed",
  "type": "object",
  "properties": {
    "modulo_referencia": {
      "type": "string",
      "description": "M\u00f3dulo que deve cumprir este contrato"
    },
    "checklist_item_id": {
      "type": "string",
      "description": "ID do item do checklist vinculado"
    },
    "versao_contrato": {
      "type": "string",
      "default": "1.0",
      "description": "Vers\u00e3o do contrato PageSpeed"
    },
    "meta_score_mobile": {
      "type": "number",
      "description": "Score meta mobile (default 100)"
    },
    "meta_score_desktop": {
      "type": "number",
      "description": "Score meta desktop (default 100)"
    },
    "core_web_vitals": {
      "type": "object",
      "properties": {
        "lcp_mobile_max_segundos": {
          "type": "number",
          "default": 2.5
        },
        "lcp_desktop_max_segundos": {
          "type": "number",
          "default": 1.3
        },
        "fcp_mobile_max_segundos": {
          "type": "number",
          "default": 1.8
        },
        "fcp_desktop_max_segundos": {
          "type": "number",
          "default": 1.2
        },
        "cls_max": {
          "type": "number",
          "default": 0.01
        },
        "tbt_max_ms": {
          "type": "number",
          "default": 150
        },
        "inp_max_ms": {
          "type": "number",
          "default": 200
        },
        "speed_index_mobile_max_segundos": {
          "type": "number",
          "default": 3.4
        },
        "speed_index_desktop_max_segundos": {
          "type": "number",
          "default": 2.0
        }
      },
      "description": "Metas Core Web Vitals"
    },
    "bundle_limits": {
      "type": "object",
      "properties": {
        "js_max_kb": {
          "type": "number",
          "default": 300
        },
        "css_max_kb": {
          "type": "number",
          "default": 50
        },
        "total_max_kb": {
          "type": "number",
          "default": 350
        },
        "js_unused_max_kb": {
          "type": "number",
          "default": 0
        },
        "css_unused_max_kb": {
          "type": "number",
          "default": 0
        }
      },
      "description": "Limites de bundle"
    },
    "cache_requirements": {
      "type": "object",
      "properties": {
        "static_assets_ttl_segundos": {
          "type": "number",
          "default": 31536000
        },
        "dynamic_content_ttl_segundos": {
          "type": "number",
          "default": 14400
        },
        "immutable_assets": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Requisitos de cache"
    },
    "optimization_checklist": {
      "type": "object",
      "properties": {
        "preconnect_external_origins": {
          "type": "boolean",
          "default": true
        },
        "css_critical_inline": {
          "type": "boolean",
          "default": true
        },
        "css_defer_noncritical": {
          "type": "boolean",
          "default": true
        },
        "lazy_load_images": {
          "type": "boolean",
          "default": true
        },
        "lazy_load_components": {
          "type": "boolean",
          "default": true
        },
        "lazy_load_routes": {
          "type": "boolean",
          "default": true
        },
        "code_splitting": {
          "type": "boolean",
          "default": true
        },
        "tree_shaking": {
          "type": "boolean",
          "default": true
        },
        "minify_js": {
          "type": "boolean",
          "default": true
        },
        "minify_css": {
          "type": "boolean",
          "default": true
        },
        "compress_gzip_brotli": {
          "type": "boolean",
          "default": true
        },
        "webp_images": {
          "type": "boolean",
          "default": true
        },
        "images_width_height": {
          "type": "boolean",
          "default": true
        },
        "images_srcset": {
          "type": "boolean",
          "default": true
        },
        "font_display_swap": {
          "type": "boolean",
          "default": true
        },
        "avoid_long_tasks": {
          "type": "boolean",
          "default": true
        },
        "sourcemaps_production": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Checklist de otimiza\u00e7\u00f5es obrigat\u00f3rias"
    },
    "dom_limits": {
      "type": "object",
      "properties": {
        "max_nodes": {
          "type": "number",
          "default": 1500
        },
        "max_depth": {
          "type": "number",
          "default": 32
        },
        "max_children_per_parent": {
          "type": "number",
          "default": 60
        }
      },
      "description": "Limites de tamanho do DOM"
    },
    "acessibilidade_wcag": {
      "type": "object",
      "properties": {
        "aria_labels_completo": {
          "type": "boolean",
          "default": true
        },
        "contrast_ratio_min": {
          "type": "number",
          "default": 4.5
        },
        "touch_targets_min_px": {
          "type": "number",
          "default": 44
        },
        "landmarks_semantic": {
          "type": "boolean",
          "default": true
        },
        "headings_sequential": {
          "type": "boolean",
          "default": true
        },
        "links_distinguishable": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Requisitos WCAG AA"
    },
    "seo_requirements": {
      "type": "object",
      "properties": {
        "robots_txt_valid": {
          "type": "boolean",
          "default": true
        },
        "meta_tags_complete": {
          "type": "boolean",
          "default": true
        },
        "sitemap_xml": {
          "type": "boolean",
          "default": true
        },
        "structured_data": {
          "type": "boolean",
          "default": true
        },
        "canonical_urls": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Requisitos SEO"
    },
    "security_headers": {
      "type": "object",
      "properties": {
        "csp": {
          "type": "boolean",
          "default": true
        },
        "hsts": {
          "type": "boolean",
          "default": true
        },
        "coop": {
          "type": "boolean",
          "default": true
        },
        "xfo": {
          "type": "boolean",
          "default": true
        },
        "trusted_types": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Headers de seguran\u00e7a obrigat\u00f3rios"
    },
    "ultimo_audit_pagespeed": {
      "type": "object",
      "description": "\u00daltimo resultado PageSpeed Insights"
    },
    "score_atual_mobile": {
      "type": "number",
      "description": "Score PageSpeed mobile atual"
    },
    "score_atual_desktop": {
      "type": "number",
      "description": "Score PageSpeed desktop atual"
    },
    "gaps_identificados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gaps identificados vs contrato"
    },
    "aprovado": {
      "type": "boolean",
      "default": false,
      "description": "M\u00f3dulo cumpre contrato PageSpeed 100/100"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de aprova\u00e7\u00e3o no contrato"
    }
  },
  "required": [
    "modulo_referencia",
    "meta_score_mobile",
    "meta_score_desktop"
  ],
  "indexes": [
    {
      "fields": [
        "modulo_referencia"
      ],
      "name": "idx_contrato_modulo",
      "unique": true
    },
    {
      "fields": [
        "aprovado",
        "-updated_date"
      ],
      "name": "idx_contrato_aprovados"
    }
  ]
}