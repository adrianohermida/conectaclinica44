{
  "name": "TratamentoDados",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica (multi-tenant)"
    },
    "modulo": {
      "type": "string",
      "enum": [
        "pacientes",
        "prontuarios",
        "agendamentos",
        "prescricoes",
        "documentos",
        "financeiro",
        "telemedicina",
        "estoque"
      ],
      "description": "M\u00f3dulo/funcionalidade"
    },
    "finalidade": {
      "type": "string",
      "description": "Finalidade do tratamento de dados"
    },
    "base_legal": {
      "type": "string",
      "enum": [
        "consentimento",
        "obrigacao_legal",
        "execucao_contrato",
        "tutela_saude",
        "interesse_legitimo",
        "exercicio_direitos"
      ],
      "description": "Base legal LGPD (Art. 7\u00ba e 11)"
    },
    "categorias_dados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categorias de dados tratados"
    },
    "dados_sensiveis": {
      "type": "boolean",
      "default": false,
      "description": "Trata dados de sa\u00fade (Art. 11 LGPD)"
    },
    "compartilhamento": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "destinatario": {
            "type": "string"
          },
          "finalidade": {
            "type": "string"
          },
          "base_legal": {
            "type": "string"
          }
        }
      },
      "description": "Com quem os dados s\u00e3o compartilhados"
    },
    "retencao_dias": {
      "type": "number",
      "description": "Per\u00edodo de reten\u00e7\u00e3o em dias"
    },
    "medidas_seguranca": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Medidas t\u00e9cnicas implementadas"
    },
    "responsavel_tratamento": {
      "type": "string",
      "description": "Respons\u00e1vel pelo tratamento"
    },
    "data_mapeamento": {
      "type": "string",
      "format": "date",
      "description": "Data do mapeamento ROPA"
    },
    "ultima_revisao": {
      "type": "string",
      "format": "date",
      "description": "\u00daltima revis\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Tratamento ativo"
    }
  },
  "required": [
    "clinica_id",
    "modulo",
    "finalidade",
    "base_legal",
    "categorias_dados"
  ]
}