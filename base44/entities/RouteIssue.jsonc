{
  "name": "RouteIssue",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "rota_quebrada",
        "loop",
        "orfao",
        "cta_sem_destino",
        "performance",
        "code_smell",
        "guard_inconsistente",
        "n_plus_1",
        "bundle_grande",
        "dependencia_circular"
      ],
      "description": "Tipo do problema"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "description": "Severidade"
    },
    "node_path": {
      "type": "string",
      "description": "Rota afetada"
    },
    "edge_id": {
      "type": "string",
      "description": "Edge afetada (se aplic\u00e1vel)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do problema"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "number"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "description": "Evid\u00eancias (trechos de c\u00f3digo)"
    },
    "suggested_fix": {
      "type": "string",
      "description": "Corre\u00e7\u00e3o sugerida"
    },
    "impact": {
      "type": "string",
      "description": "Impacto estimado"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "ignored"
      ],
      "default": "open",
      "description": "Status"
    },
    "ai_diagnosis": {
      "type": "string",
      "description": "Diagn\u00f3stico gerado pela IA"
    },
    "ai_prompt": {
      "type": "string",
      "description": "Prompt t\u00e9cnico Base44 gerado"
    }
  },
  "required": [
    "type",
    "severity",
    "description"
  ],
  "indexes": [
    {
      "fields": [
        "status",
        "-severity"
      ]
    },
    {
      "fields": [
        "type",
        "-created_date"
      ]
    },
    {
      "fields": [
        "node_path"
      ]
    }
  ]
}