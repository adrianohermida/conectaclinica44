{
  "name": "ConfiguracaoWhatsApp",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica (multi-tenant isolado)"
    },
    "twilio_phone_number": {
      "type": "string",
      "description": "N\u00famero WhatsApp Twilio (+5511...)"
    },
    "twilio_account_sid": {
      "type": "string",
      "description": "Account SID isolado da cl\u00ednica"
    },
    "twilio_auth_token_encrypted": {
      "type": "string",
      "description": "Auth token criptografado"
    },
    "twilio_phone_sid": {
      "type": "string",
      "description": "SID do n\u00famero comprado"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "WhatsApp ativo"
    },
    "mensagem_boas_vindas": {
      "type": "string",
      "default": "Ol\u00e1! Seja bem-vindo ao atendimento via WhatsApp.",
      "description": "Primeira mensagem autom\u00e1tica"
    },
    "mensagem_offline": {
      "type": "string",
      "default": "Estamos offline. Deixe sua mensagem que responderemos em breve!",
      "description": "Mensagem fora do hor\u00e1rio"
    },
    "horario_atendimento": {
      "type": "object",
      "description": "Configura\u00e7\u00e3o hor\u00e1rio (mesmo padr\u00e3o widget)"
    },
    "ia_habilitada": {
      "type": "boolean",
      "default": false,
      "description": "Auto-resposta IA ativa"
    },
    "agente_ia_vinculado": {
      "type": "string",
      "description": "Nome do agente Base44 vinculado (secretaria_ia_XXX)"
    },
    "custo_mensal_twilio_usd": {
      "type": "number",
      "description": "Custo mensal Twilio em USD"
    },
    "total_mensagens_mes": {
      "type": "number",
      "default": 0,
      "description": "Total mensagens enviadas no m\u00eas"
    },
    "total_mensagens_recebidas_mes": {
      "type": "number",
      "default": 0,
      "description": "Total mensagens recebidas no m\u00eas"
    },
    "webhook_url": {
      "type": "string",
      "description": "URL webhook configurada no Twilio"
    }
  },
  "required": [
    "clinica_id",
    "twilio_phone_number",
    "twilio_account_sid"
  ],
  "indexes": [
    {
      "fields": [
        "clinica_id"
      ],
      "name": "idx_whatsapp_clinica",
      "unique": true
    },
    {
      "fields": [
        "twilio_phone_number"
      ],
      "name": "idx_whatsapp_numero",
      "unique": true
    }
  ]
}