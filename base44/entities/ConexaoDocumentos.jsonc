{
  "name": "ConexaoDocumentos",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da conex\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conex\u00e3o"
    },
    "documentos_ordenados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "documento_id": {
            "type": "string"
          },
          "ordem": {
            "type": "number"
          },
          "titulo": {
            "type": "string"
          }
        }
      },
      "description": "Lista ordenada de documentos conectados"
    },
    "total_documentos": {
      "type": "number",
      "default": 0,
      "description": "Total de documentos na conex\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Conex\u00e3o ativa"
    },
    "pasta_id": {
      "type": "string",
      "description": "Pasta onde a conex\u00e3o est\u00e1"
    },
    "conteudo_concatenado": {
      "type": "string",
      "description": "Conte\u00fado indexado concatenado na ordem"
    }
  },
  "required": [
    "titulo",
    "documentos_ordenados"
  ],
  "indexes": [
    {
      "fields": [
        "pasta_id",
        "-created_date"
      ],
      "name": "idx_conexao_pasta"
    },
    {
      "fields": [
        "ativo",
        "-created_date"
      ],
      "name": "idx_conexao_ativa"
    }
  ]
}