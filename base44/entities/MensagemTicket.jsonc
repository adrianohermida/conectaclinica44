{
  "name": "MensagemTicket",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica (multi-tenant)"
    },
    "ticket_id": {
      "type": "string",
      "description": "ID do ticket relacionado"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "mensagem",
        "nota_interna",
        "sistema"
      ],
      "default": "mensagem",
      "description": "Tipo de mensagem"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado da mensagem"
    },
    "remetente_tipo": {
      "type": "string",
      "enum": [
        "cliente",
        "atendente",
        "sistema_ia",
        "sistema"
      ],
      "description": "Tipo do remetente"
    },
    "remetente_nome": {
      "type": "string",
      "description": "Nome do remetente"
    },
    "remetente_email": {
      "type": "string",
      "description": "Email do remetente"
    },
    "remetente_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio remetente (se aplic\u00e1vel)"
    },
    "visivel_cliente": {
      "type": "boolean",
      "default": true,
      "description": "Mensagem vis\u00edvel ao cliente (notas internas = false)"
    },
    "lida": {
      "type": "boolean",
      "default": false,
      "description": "Mensagem lida"
    },
    "data_leitura": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da leitura"
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "tamanho": {
            "type": "number"
          }
        }
      },
      "description": "Anexos da mensagem"
    },
    "metadata": {
      "type": "object",
      "description": "Metadados adicionais (agente_slug, conversation_id, tempo_resposta_ms)"
    }
  },
  "required": [
    "clinica_id",
    "ticket_id",
    "conteudo",
    "remetente_tipo"
  ],
  "indexes": [
    {
      "fields": [
        "clinica_id",
        "ticket_id",
        "-created_date"
      ],
      "name": "idx_mensagem_ticket_timeline",
      "comment": "CRITICAL: Multi-tenant - SEMPRE query com clinica_id + ticket_id"
    },
    {
      "fields": [
        "ticket_id",
        "-created_date"
      ],
      "name": "idx_mensagem_ticket"
    },
    {
      "fields": [
        "clinica_id",
        "-created_date"
      ],
      "name": "idx_mensagem_timeline"
    },
    {
      "fields": [
        "remetente_tipo",
        "-created_date"
      ],
      "name": "idx_mensagem_tipo"
    }
  ]
}