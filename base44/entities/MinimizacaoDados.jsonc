{
  "name": "MinimizacaoDados",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica"
    },
    "entidade": {
      "type": "string",
      "description": "Entidade avaliada"
    },
    "campos_coletados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "campo": {
            "type": "string"
          },
          "necessario": {
            "type": "boolean"
          },
          "justificativa": {
            "type": "string"
          },
          "sensivel": {
            "type": "boolean"
          }
        }
      },
      "description": "Avalia\u00e7\u00e3o de campos"
    },
    "campos_desnecessarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Campos identificados como desnecess\u00e1rios"
    },
    "data_avaliacao": {
      "type": "string",
      "format": "date",
      "description": "Data da avalia\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "conforme",
        "nao_conforme",
        "em_analise"
      ],
      "default": "em_analise",
      "description": "Status de conformidade"
    },
    "acoes_corretivas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "A\u00e7\u00f5es para minimiza\u00e7\u00e3o"
    }
  },
  "required": [
    "clinica_id",
    "entidade",
    "campos_coletados"
  ]
}