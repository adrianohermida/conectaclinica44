{
  "name": "ContaReceber",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica (multi-tenant)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conta"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "consulta",
        "procedimento",
        "venda_produtos",
        "convenio",
        "particular",
        "outros"
      ],
      "description": "Categoria da receita"
    },
    "paciente_nome": {
      "type": "string",
      "description": "Nome do paciente"
    },
    "paciente_id": {
      "type": "string",
      "description": "ID do paciente"
    },
    "valor": {
      "type": "number",
      "description": "Valor a receber"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "data_recebimento": {
      "type": "string",
      "format": "date",
      "description": "Data do recebimento"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "recebido",
        "vencido",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status da conta"
    }
  },
  "required": [
    "clinica_id",
    "descricao",
    "valor",
    "data_vencimento"
  ],
  "indexes": [
    {
      "fields": [
        "clinica_id",
        "-data_vencimento"
      ],
      "name": "idx_contareceber_vencimento"
    },
    {
      "fields": [
        "clinica_id",
        "status",
        "-data_vencimento"
      ],
      "name": "idx_contareceber_status"
    },
    {
      "fields": [
        "clinica_id",
        "paciente_id",
        "-data_vencimento"
      ],
      "name": "idx_contareceber_paciente"
    }
  ]
}