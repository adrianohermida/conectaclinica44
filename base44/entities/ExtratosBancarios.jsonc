{
  "name": "ExtratosBancarios",
  "type": "object",
  "properties": {
    "banco": {
      "type": "string",
      "description": "Nome do banco"
    },
    "agencia": {
      "type": "string",
      "description": "Ag\u00eancia"
    },
    "conta": {
      "type": "string",
      "description": "N\u00famero da conta"
    },
    "tipo_conta": {
      "type": "string",
      "enum": [
        "corrente",
        "poupanca",
        "investimento"
      ],
      "description": "Tipo de conta"
    },
    "periodo_inicio": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio do per\u00edodo"
    },
    "periodo_fim": {
      "type": "string",
      "format": "date",
      "description": "Fim do per\u00edodo"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL do arquivo do extrato"
    },
    "nome_arquivo": {
      "type": "string",
      "description": "Nome do arquivo"
    },
    "processado": {
      "type": "boolean",
      "default": false,
      "description": "Se o extrato foi processado e importado"
    },
    "data_importacao": {
      "type": "string",
      "format": "date",
      "description": "Data da importa\u00e7\u00e3o"
    },
    "transacoes_importadas": {
      "type": "number",
      "description": "Quantidade de transa\u00e7\u00f5es importadas"
    },
    "saldo_inicial": {
      "type": "number",
      "description": "Saldo inicial do per\u00edodo"
    },
    "saldo_final": {
      "type": "number",
      "description": "Saldo final do per\u00edodo"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "banco",
    "periodo_inicio",
    "periodo_fim"
  ]
}