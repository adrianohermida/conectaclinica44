{
  "name": "CertificadoDigital",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome/Identifica\u00e7\u00e3o do certificado"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "a1",
        "a3"
      ],
      "description": "Tipo do certificado"
    },
    "titular": {
      "type": "string",
      "description": "Nome do titular"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ do titular"
    },
    "autoridade_certificadora": {
      "type": "string",
      "description": "Autoridade certificadora (AC)"
    },
    "emissor": {
      "type": "string",
      "description": "Emissor do certificado"
    },
    "data_emissao": {
      "type": "string",
      "format": "date",
      "description": "Data de emiss\u00e3o"
    },
    "data_validade": {
      "type": "string",
      "format": "date",
      "description": "Data de validade"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "vencido",
        "revogado",
        "suspenso"
      ],
      "default": "ativo",
      "description": "Status do certificado"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL do arquivo do certificado (.pfx para A1)"
    },
    "pkcs12_cert_encrypted": {
      "type": "string",
      "description": "Certificado criptografado (base64 + AES-256-GCM)"
    },
    "pkcs12_pass_encrypted": {
      "type": "string",
      "description": "Senha criptografada (AES-256-GCM)"
    },
    "arquivo_nome": {
      "type": "string",
      "description": "Nome original do arquivo"
    },
    "senha_protegida": {
      "type": "boolean",
      "default": true,
      "description": "Se o certificado possui senha"
    },
    "numero_serie": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie do certificado"
    },
    "dispositivo_a3": {
      "type": "string",
      "enum": [
        "token",
        "smartcard",
        "hsm",
        "nenhum"
      ],
      "default": "nenhum",
      "description": "Tipo de dispositivo A3"
    },
    "modelo_dispositivo": {
      "type": "string",
      "description": "Modelo do dispositivo (token/smartcard)"
    },
    "uso_autorizado": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sistemas autorizados a usar o certificado"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "nome",
    "tipo",
    "titular",
    "data_validade"
  ]
}