{
  "name": "AceiteTermoLegal",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica (CRITICAL: multi-tenant isolation)"
    },
    "termo_legal_id": {
      "type": "string",
      "description": "ID do termo aceito"
    },
    "termo_versao": {
      "type": "string",
      "description": "Vers\u00e3o do termo no momento do aceite"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio no momento do aceite"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "usuario_cpf": {
      "type": "string",
      "description": "CPF do usu\u00e1rio (se dispon\u00edvel)"
    },
    "aceito": {
      "type": "boolean",
      "default": false,
      "description": "Aceite confirmado"
    },
    "timestamp_aceite": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp exato do aceite"
    },
    "ip_address": {
      "type": "string",
      "description": "IP do aceite"
    },
    "user_agent": {
      "type": "string",
      "description": "User agent do navegador"
    },
    "geolocation": {
      "type": "object",
      "description": "Geolocaliza\u00e7\u00e3o (opcional)"
    },
    "hash_aceite": {
      "type": "string",
      "description": "Hash SHA-256 da transa\u00e7\u00e3o (termo_id + user_id + timestamp + ip)"
    },
    "hash_termo_original": {
      "type": "string",
      "description": "Hash do termo no momento do aceite (prova de integridade)"
    },
    "certificado_url": {
      "type": "string",
      "description": "URL do certificado PDF de auditoria MP 2.200/2"
    },
    "cadeia_custodia": {
      "type": "object",
      "description": "Dados completos da cadeia de cust\u00f3dia digital (inclui timestamp_proof se dispon\u00edvel)"
    },
    "timestamp_blockchain": {
      "type": "object",
      "description": "Prova de timestamp em blockchain p\u00fablico (OpenTimestamps Bitcoin)"
    },
    "timestamp_icp_brasil": {
      "type": "object",
      "description": "Carimbo de tempo ICP-Brasil (se upgrade contratado)"
    },
    "revogado": {
      "type": "boolean",
      "default": false,
      "description": "Aceite revogado pelo usu\u00e1rio"
    },
    "data_revogacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de revoga\u00e7\u00e3o (se aplic\u00e1vel)"
    }
  },
  "required": [
    "clinica_id",
    "termo_legal_id",
    "usuario_id",
    "usuario_email",
    "timestamp_aceite",
    "ip_address",
    "hash_aceite",
    "hash_termo_original"
  ],
  "indexes": [
    {
      "fields": [
        "clinica_id",
        "usuario_email",
        "termo_legal_id"
      ],
      "name": "idx_aceite_user_termo",
      "unique": false
    },
    {
      "fields": [
        "clinica_id",
        "-timestamp_aceite"
      ],
      "name": "idx_aceite_timeline"
    },
    {
      "fields": [
        "hash_aceite"
      ],
      "name": "idx_aceite_hash",
      "unique": true
    }
  ]
}