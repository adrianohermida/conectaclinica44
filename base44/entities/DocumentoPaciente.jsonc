{
  "name": "DocumentoPaciente",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica (multi-tenant)"
    },
    "paciente_id": {
      "type": "string",
      "description": "ID do paciente"
    },
    "paciente_nome": {
      "type": "string",
      "description": "Nome do paciente"
    },
    "prontuario_id": {
      "type": "string",
      "description": "ID do prontu\u00e1rio vinculado"
    },
    "tipo_documento": {
      "type": "string",
      "description": "Tipo de documento"
    },
    "nome_arquivo": {
      "type": "string",
      "description": "Nome do arquivo"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL do arquivo"
    },
    "data_upload": {
      "type": "string",
      "format": "date",
      "description": "Data do upload"
    },
    "data_documento": {
      "type": "string",
      "format": "date",
      "description": "Data do documento original"
    },
    "tamanho_bytes": {
      "type": "number",
      "description": "Tamanho em bytes"
    },
    "extensao": {
      "type": "string",
      "description": "Extens\u00e3o do arquivo"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do documento"
    },
    "medico_solicitante": {
      "type": "string",
      "description": "M\u00e9dico que solicitou/anexou"
    },
    "analisado_ia": {
      "type": "boolean",
      "default": false,
      "description": "Se foi analisado por IA"
    }
  },
  "required": [
    "clinica_id",
    "paciente_id",
    "tipo_documento",
    "arquivo_url"
  ],
  "indexes": [
    {
      "fields": [
        "clinica_id",
        "paciente_id",
        "-data_upload"
      ],
      "name": "idx_documento_paciente"
    },
    {
      "fields": [
        "clinica_id",
        "prontuario_id",
        "-data_upload"
      ],
      "name": "idx_documento_prontuario_optimized"
    },
    {
      "fields": [
        "clinica_id",
        "tipo_documento",
        "-data_documento"
      ],
      "name": "idx_documento_tipo"
    },
    {
      "fields": [
        "clinica_id",
        "-data_upload"
      ],
      "name": "idx_documento_timeline_optimized"
    }
  ]
}