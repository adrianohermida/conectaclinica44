{
  "name": "AssinaturaDigitalLog",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica (multi-tenant)"
    },
    "documento_compliance_id": {
      "type": "string",
      "description": "ID do DocumentoCompliance (reposit\u00f3rio)"
    },
    "aceite_termo_id": {
      "type": "string",
      "description": "ID do AceiteTermoLegal (se aplic\u00e1vel)"
    },
    "documento_tipo": {
      "type": "string",
      "description": "Tipo do documento (termo_legal, contrato, atestado, etc)"
    },
    "documento_nome": {
      "type": "string",
      "description": "Nome do documento enviado"
    },
    "provider": {
      "type": "string",
      "enum": [
        "autentique",
        "clicksign",
        "docusign"
      ],
      "default": "autentique",
      "description": "Provedor de assinatura digital"
    },
    "authentique_document_id": {
      "type": "string",
      "description": "ID do documento no Autentique"
    },
    "signatarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "link_assinatura": {
            "type": "string"
          },
          "data_assinatura": {
            "type": "string"
          }
        }
      },
      "description": "Lista de signat\u00e1rios e status"
    },
    "arquivo_original_url": {
      "type": "string",
      "description": "URL do arquivo original enviado"
    },
    "arquivo_assinado_url": {
      "type": "string",
      "description": "URL do PDF assinado (ap\u00f3s webhook)"
    },
    "status": {
      "type": "string",
      "enum": [
        "enviado",
        "assinando",
        "concluido",
        "cancelado"
      ],
      "default": "enviado",
      "description": "Status do processo"
    },
    "credito_utilizado": {
      "type": "number",
      "default": 1,
      "description": "Cr\u00e9ditos consumidos"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de conclus\u00e3o"
    }
  },
  "required": [
    "clinica_id",
    "documento_nome",
    "provider"
  ],
  "indexes": [
    {
      "fields": [
        "clinica_id",
        "-created_date"
      ],
      "name": "idx_assinatura_timeline"
    },
    {
      "fields": [
        "authentique_document_id"
      ],
      "name": "idx_assinatura_autentique",
      "unique": true,
      "sparse": true
    },
    {
      "fields": [
        "documento_compliance_id"
      ],
      "name": "idx_assinatura_doc_repo",
      "sparse": true
    },
    {
      "fields": [
        "status",
        "-created_date"
      ],
      "name": "idx_assinatura_status"
    }
  ]
}