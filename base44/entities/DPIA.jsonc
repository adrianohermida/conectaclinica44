{
  "name": "DPIA",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica"
    },
    "tratamento": {
      "type": "string",
      "description": "Tratamento de dados avaliado"
    },
    "data_avaliacao": {
      "type": "string",
      "format": "date",
      "description": "Data da avalia\u00e7\u00e3o"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pela DPIA"
    },
    "descricao_tratamento": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do tratamento"
    },
    "volume_titulares": {
      "type": "number",
      "description": "Volume estimado de titulares"
    },
    "necessidade_proporcionalidade": {
      "type": "object",
      "properties": {
        "necessario": {
          "type": "boolean"
        },
        "justificativa": {
          "type": "string"
        }
      },
      "description": "An\u00e1lise de necessidade e proporcionalidade"
    },
    "riscos_identificados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risco": {
            "type": "string"
          },
          "probabilidade": {
            "type": "string",
            "enum": [
              "baixa",
              "media",
              "alta"
            ]
          },
          "impacto": {
            "type": "string",
            "enum": [
              "baixo",
              "medio",
              "alto",
              "muito_alto"
            ]
          },
          "mitigacao": {
            "type": "string"
          }
        }
      },
      "description": "Riscos aos direitos dos titulares"
    },
    "medidas_mitigacao": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Medidas de mitiga\u00e7\u00e3o implementadas"
    },
    "conclusao": {
      "type": "string",
      "enum": [
        "aprovado",
        "aprovado_com_condicoes",
        "reprovado",
        "em_analise"
      ],
      "default": "em_analise",
      "description": "Conclus\u00e3o da DPIA"
    },
    "condicoes": {
      "type": "string",
      "description": "Condi\u00e7\u00f5es (se aplic\u00e1vel)"
    },
    "revisao_necessaria": {
      "type": "string",
      "format": "date",
      "description": "Data de pr\u00f3xima revis\u00e3o"
    },
    "consulta_encarregado": {
      "type": "boolean",
      "default": false,
      "description": "Encarregado consultado?"
    },
    "consulta_titulares": {
      "type": "boolean",
      "default": false,
      "description": "Titulares consultados?"
    }
  },
  "required": [
    "clinica_id",
    "tratamento",
    "data_avaliacao",
    "responsavel",
    "volume_titulares"
  ]
}