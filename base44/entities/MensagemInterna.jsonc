{
  "name": "MensagemInterna",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica (multi-tenant)"
    },
    "remetente_id": {
      "type": "string",
      "description": "ID do remetente"
    },
    "remetente_nome": {
      "type": "string",
      "description": "Nome do remetente"
    },
    "destinatario_id": {
      "type": "string",
      "description": "ID do destinat\u00e1rio"
    },
    "destinatario_nome": {
      "type": "string",
      "description": "Nome do destinat\u00e1rio"
    },
    "tipo_conversa": {
      "type": "string",
      "enum": [
        "equipe_equipe",
        "equipe_paciente",
        "suporte_tecnico"
      ],
      "description": "Tipo de conversa"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado da mensagem"
    },
    "anexo_url": {
      "type": "string",
      "description": "URL do anexo (se houver)"
    },
    "lida": {
      "type": "boolean",
      "default": false,
      "description": "Mensagem lida"
    },
    "arquivada": {
      "type": "boolean",
      "default": false,
      "description": "Mensagem arquivada"
    },
    "data_leitura": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da leitura"
    },
    "ticket_id": {
      "type": "string",
      "description": "ID do ticket relacionado (se aplic\u00e1vel)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "agendamento",
        "prontuario",
        "paciente",
        "financeiro",
        "estoque",
        "ia",
        "sistema"
      ],
      "description": "Categoria da notifica\u00e7\u00e3o"
    },
    "assunto": {
      "type": "string",
      "description": "Assunto da notifica\u00e7\u00e3o"
    },
    "corpo": {
      "type": "string",
      "description": "Corpo da mensagem"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags de categoriza\u00e7\u00e3o"
    }
  },
  "required": [
    "clinica_id",
    "remetente_id",
    "destinatario_id",
    "conteudo",
    "tipo_conversa"
  ],
  "indexes": [
    {
      "fields": [
        "clinica_id",
        "destinatario_id",
        "-created_date"
      ],
      "name": "idx_mensagem_destinatario_timeline"
    },
    {
      "fields": [
        "clinica_id",
        "ticket_id",
        "-created_date"
      ],
      "name": "idx_mensagem_ticket_optimized"
    },
    {
      "fields": [
        "clinica_id",
        "lida",
        "-created_date"
      ],
      "name": "idx_mensagem_nao_lidas"
    },
    {
      "fields": [
        "clinica_id",
        "destinatario_id",
        "lida"
      ],
      "name": "idx_mensagem_inbox_optimized"
    }
  ]
}