{
  "name": "SistemaGovernamental",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do sistema"
    },
    "sigla": {
      "type": "string",
      "description": "Sigla do sistema"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "fiscal",
        "contabil",
        "trabalhista",
        "previdenciario",
        "bancario",
        "outro"
      ],
      "description": "Tipo do sistema"
    },
    "esfera": {
      "type": "string",
      "enum": [
        "federal",
        "estadual",
        "municipal",
        "privado"
      ],
      "description": "Esfera"
    },
    "url_acesso": {
      "type": "string",
      "description": "URL de acesso ao sistema"
    },
    "usuario": {
      "type": "string",
      "description": "Usu\u00e1rio de acesso"
    },
    "certificado_digital": {
      "type": "boolean",
      "default": false,
      "description": "Requer certificado digital"
    },
    "tipo_certificado": {
      "type": "string",
      "enum": [
        "e-cpf",
        "e-cnpj",
        "ambos",
        "nenhum"
      ],
      "description": "Tipo de certificado necess\u00e1rio"
    },
    "data_validade_acesso": {
      "type": "string",
      "format": "date",
      "description": "Validade do acesso/procura\u00e7\u00e3o"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pelo acesso"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es e instru\u00e7\u00f5es"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 ativo"
    }
  },
  "required": [
    "nome",
    "tipo",
    "esfera"
  ]
}