{
  "name": "NotaPaciente",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica (multi-tenant)"
    },
    "contato_id": {
      "type": "string",
      "description": "ID do contato"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado da nota"
    },
    "criado_por": {
      "type": "string",
      "description": "ID do usu\u00e1rio que criou"
    },
    "criado_por_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que criou"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "arquivada"
      ],
      "default": "ativa",
      "description": "Status da nota"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para organiza\u00e7\u00e3o"
    }
  },
  "required": [
    "clinica_id",
    "contato_id",
    "conteudo",
    "criado_por",
    "criado_por_nome"
  ],
  "indexes": [
    {
      "fields": [
        "clinica_id",
        "contato_id",
        "-created_date"
      ],
      "name": "idx_nota_contato"
    },
    {
      "fields": [
        "clinica_id",
        "status",
        "-created_date"
      ],
      "name": "idx_nota_status"
    }
  ]
}