{
  "name": "ArtigoAjuda",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do artigo"
    },
    "slug": {
      "type": "string",
      "description": "URL amig\u00e1vel"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "primeiros_passos",
        "agenda",
        "pacientes",
        "prontuarios",
        "financeiro",
        "ia",
        "integracao",
        "troubleshooting"
      ],
      "description": "Categoria"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado markdown"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags de busca"
    },
    "publicado": {
      "type": "boolean",
      "default": true,
      "description": "Publicado?"
    },
    "visualizacoes": {
      "type": "number",
      "default": 0
    },
    "util": {
      "type": "number",
      "default": 0,
      "description": "Votos \u00fateis"
    }
  },
  "required": [
    "titulo",
    "slug",
    "conteudo",
    "categoria"
  ]
}