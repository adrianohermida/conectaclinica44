{
  "name": "ConteudoLegal",
  "type": "object",
  "properties": {
    "tipo_documento": {
      "type": "string",
      "enum": [
        "termos_uso",
        "politica_privacidade",
        "lgpd",
        "contrato_custom"
      ],
      "description": "Tipo de documento legal"
    },
    "categoria_custom": {
      "type": "string",
      "description": "Categoria livre: procura\u00e7\u00e3o, contrato, declara\u00e7\u00e3o, etc."
    },
    "uso_tipo": {
      "type": "string",
      "enum": [
        "publico",
        "interno"
      ],
      "default": "publico",
      "description": "Se o documento \u00e9 para uso p\u00fablico (site) ou interno (contratos/modals)"
    },
    "slug": {
      "type": "string",
      "description": "Slug da URL (ex: termos-uso, politica-privacidade) - customiz\u00e1vel pelo admin"
    },
    "titulo_custom": {
      "type": "string",
      "description": "T\u00edtulo personalizado para contratos internos"
    },
    "versao": {
      "type": "string",
      "default": "1.0.0",
      "description": "Vers\u00e3o do documento (semver)"
    },
    "ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se esta vers\u00e3o est\u00e1 publicada"
    },
    "template_padrao": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 template padr\u00e3o do sistema"
    },
    "blocos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ordem": {
            "type": "number"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "secao",
              "paragrafo",
              "lista",
              "tabela"
            ]
          },
          "titulo": {
            "type": "string"
          },
          "conteudo_html": {
            "type": "string"
          },
          "expansivel": {
            "type": "boolean",
            "default": true
          },
          "visivel": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "default": []
    },
    "metadata": {
      "type": "object",
      "properties": {
        "autor_id": {
          "type": "string"
        },
        "autor_nome": {
          "type": "string"
        },
        "data_criacao": {
          "type": "string",
          "format": "date-time"
        },
        "data_publicacao": {
          "type": "string",
          "format": "date-time"
        },
        "hash_sha256": {
          "type": "string"
        },
        "changelog": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "versao": {
                "type": "string"
              },
              "data": {
                "type": "string",
                "format": "date-time"
              },
              "mudancas": {
                "type": "string"
              }
            }
          }
        }
      },
      "default": {}
    },
    "integracao_esign": {
      "type": "object",
      "properties": {
        "requer_assinatura": {
          "type": "boolean",
          "default": false
        },
        "autentique_document_id": {
          "type": "string"
        },
        "autentique_status": {
          "type": "string",
          "enum": [
            "pending",
            "signed",
            "cancelled"
          ],
          "description": "Status da assinatura Autentique"
        },
        "tipo_aceite": {
          "type": "string",
          "enum": [
            "checkbox",
            "modal",
            "esign_unilateral",
            "esign_bilateral"
          ],
          "default": "checkbox"
        },
        "signatarios_fixos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Emails de signat\u00e1rios fixos (esign_bilateral)"
        },
        "pdf_assinado_url": {
          "type": "string",
          "description": "URI do PDF final assinado (file_uri privado)"
        }
      },
      "default": {}
    }
  },
  "required": [
    "tipo_documento",
    "versao",
    "uso_tipo"
  ],
  "indexes": [
    {
      "fields": [
        "tipo_documento",
        "-versao"
      ],
      "name": "idx_tipo_versao"
    },
    {
      "fields": [
        "tipo_documento",
        "ativo"
      ],
      "name": "idx_tipo_ativo"
    },
    {
      "fields": [
        "uso_tipo",
        "-created_date"
      ],
      "name": "idx_uso_tipo"
    },
    {
      "fields": [
        "slug"
      ],
      "unique": true,
      "name": "idx_slug_unique",
      "partialFilterExpression": {
        "slug": {
          "$exists": true,
          "$ne": ""
        }
      }
    }
  ]
}