{
  "name": "TemplateResposta",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica (multi-tenant)"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do template"
    },
    "atalho": {
      "type": "string",
      "description": "Atalho para inser\u00e7\u00e3o r\u00e1pida (ex: /horarios)"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado do template"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "agendamento",
        "financeiro",
        "suporte",
        "comercial",
        "seguimento",
        "outro"
      ],
      "default": "outro",
      "description": "Categoria do template"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para busca"
    },
    "uso_count": {
      "type": "number",
      "default": 0,
      "description": "Quantas vezes foi usado"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Template ativo"
    }
  },
  "required": [
    "clinica_id",
    "titulo",
    "conteudo"
  ],
  "indexes": [
    {
      "fields": [
        "clinica_id",
        "ativo",
        "-uso_count"
      ],
      "name": "idx_template_popular"
    },
    {
      "fields": [
        "clinica_id",
        "atalho"
      ],
      "name": "idx_template_atalho",
      "unique": true,
      "sparse": true,
      "partialFilterExpression": {
        "atalho": {
          "$exists": true,
          "$ne": ""
        }
      }
    }
  ]
}