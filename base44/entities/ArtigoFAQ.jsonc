{
  "name": "ArtigoFAQ",
  "type": "object",
  "properties": {
    "secao": {
      "type": "string",
      "enum": [
        "produto",
        "tecnico",
        "comercial",
        "suporte",
        "compliance",
        "onboarding"
      ],
      "description": "Se\u00e7\u00e3o do FAQ"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "agenda",
        "pacientes",
        "prontuarios",
        "telemedicina",
        "financeiro",
        "planos",
        "whatsapp",
        "email",
        "geral"
      ],
      "description": "Categoria espec\u00edfica"
    },
    "modulo_vinculado": {
      "type": "string",
      "description": "Slug do m\u00f3dulo (agenda, pacientes, etc)"
    },
    "pergunta": {
      "type": "string",
      "description": "Pergunta frequente"
    },
    "resposta": {
      "type": "string",
      "description": "Resposta detalhada (markdown)"
    },
    "resposta_curta": {
      "type": "string",
      "description": "Resposta r\u00e1pida para chatbot"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para busca sem\u00e2ntica"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "FAQ ativo"
    },
    "visualizacoes": {
      "type": "number",
      "default": 0,
      "description": "Contador de visualiza\u00e7\u00f5es"
    },
    "util_count": {
      "type": "number",
      "default": 0,
      "description": "Votos \u00fateis"
    },
    "nao_util_count": {
      "type": "number",
      "default": 0,
      "description": "Votos n\u00e3o \u00fateis"
    },
    "embeddings": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Vetor embeddings para busca sem\u00e2ntica"
    },
    "aprovado": {
      "type": "boolean",
      "default": false,
      "description": "Aprovado para IA usar"
    },
    "aprovado_por": {
      "type": "string",
      "description": "Email do admin que aprovou"
    },
    "origem": {
      "type": "string",
      "enum": [
        "manual",
        "ia_sugerida",
        "feedback_usuario"
      ],
      "default": "manual"
    },
    "sugerido_por_ia": {
      "type": "object",
      "description": "Metadata de sugest\u00e3o IA"
    }
  },
  "required": [
    "secao",
    "pergunta",
    "resposta"
  ],
  "indexes": [
    {
      "fields": [
        "ativo",
        "-ordem"
      ],
      "name": "idx_faq_ativo"
    },
    {
      "fields": [
        "categoria",
        "-visualizacoes"
      ],
      "name": "idx_faq_categoria"
    },
    {
      "fields": [
        "aprovado",
        "ativo"
      ],
      "name": "idx_faq_ia"
    }
  ]
}