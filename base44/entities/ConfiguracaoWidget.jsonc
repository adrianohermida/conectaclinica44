{
  "name": "ConfiguracaoWidget",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica (\u00fanico por cl\u00ednica)"
    },
    "mensagem_boas_vindas": {
      "type": "string",
      "default": "Ol\u00e1! Como podemos ajudar?",
      "description": "Mensagem inicial do widget"
    },
    "texto_lancador": {
      "type": "string",
      "default": "Ajuda",
      "description": "Texto do bot\u00e3o flutuante"
    },
    "titulo": {
      "type": "string",
      "default": "Atendimento",
      "description": "T\u00edtulo exibido no header do widget"
    },
    "cor_primaria": {
      "type": "string",
      "default": "#7E57FF",
      "description": "Cor principal (hex)"
    },
    "cor_secundaria": {
      "type": "string",
      "default": "#f5f3ff",
      "description": "Cor secund\u00e1ria (hex)"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo da cl\u00ednica no widget"
    },
    "topicos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "icone": {
            "type": "string"
          }
        }
      },
      "default": [
        {
          "titulo": "Converse conosco",
          "descricao": "Tire suas d\u00favidas",
          "icone": "MessageSquare"
        },
        {
          "titulo": "Suporte ao Cliente",
          "descricao": "Atendimento r\u00e1pido",
          "icone": "HelpCircle"
        }
      ],
      "description": "T\u00f3picos conversacionais"
    },
    "faqs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pergunta": {
            "type": "string"
          },
          "resposta": {
            "type": "string"
          }
        }
      },
      "description": "Perguntas frequentes (auto-resposta IA)"
    },
    "campos_pre_chat": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "campo": {
            "type": "string",
            "enum": [
              "nome",
              "email",
              "telefone",
              "assunto",
              "empresa",
              "departamento"
            ]
          },
          "obrigatorio": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "default": [
        {
          "campo": "nome",
          "obrigatorio": true,
          "label": "Nome completo"
        },
        {
          "campo": "email",
          "obrigatorio": true,
          "label": "Email"
        },
        {
          "campo": "telefone",
          "obrigatorio": false,
          "label": "Telefone"
        },
        {
          "campo": "assunto",
          "obrigatorio": false,
          "label": "Assunto"
        }
      ],
      "description": "Campos customiz\u00e1veis formul\u00e1rio pr\u00e9-chat"
    },
    "horario_atendimento": {
      "type": "object",
      "properties": {
        "ativo": {
          "type": "boolean",
          "default": false
        },
        "dias": {
          "type": "object",
          "properties": {
            "seg": {
              "type": "object",
              "properties": {
                "ativo": {
                  "type": "boolean"
                },
                "inicio": {
                  "type": "string"
                },
                "fim": {
                  "type": "string"
                }
              }
            },
            "ter": {
              "type": "object",
              "properties": {
                "ativo": {
                  "type": "boolean"
                },
                "inicio": {
                  "type": "string"
                },
                "fim": {
                  "type": "string"
                }
              }
            },
            "qua": {
              "type": "object",
              "properties": {
                "ativo": {
                  "type": "boolean"
                },
                "inicio": {
                  "type": "string"
                },
                "fim": {
                  "type": "string"
                }
              }
            },
            "qui": {
              "type": "object",
              "properties": {
                "ativo": {
                  "type": "boolean"
                },
                "inicio": {
                  "type": "string"
                },
                "fim": {
                  "type": "string"
                }
              }
            },
            "sex": {
              "type": "object",
              "properties": {
                "ativo": {
                  "type": "boolean"
                },
                "inicio": {
                  "type": "string"
                },
                "fim": {
                  "type": "string"
                }
              }
            },
            "sab": {
              "type": "object",
              "properties": {
                "ativo": {
                  "type": "boolean"
                },
                "inicio": {
                  "type": "string"
                },
                "fim": {
                  "type": "string"
                }
              }
            },
            "dom": {
              "type": "object",
              "properties": {
                "ativo": {
                  "type": "boolean"
                },
                "inicio": {
                  "type": "string"
                },
                "fim": {
                  "type": "string"
                }
              }
            }
          }
        },
        "mensagem_offline": {
          "type": "string",
          "default": "Estamos fora do hor\u00e1rio de atendimento. Deixe sua mensagem que responderemos em breve!"
        }
      },
      "default": {
        "ativo": false,
        "dias": {
          "seg": {
            "ativo": true,
            "inicio": "09:00",
            "fim": "18:00"
          },
          "ter": {
            "ativo": true,
            "inicio": "09:00",
            "fim": "18:00"
          },
          "qua": {
            "ativo": true,
            "inicio": "09:00",
            "fim": "18:00"
          },
          "qui": {
            "ativo": true,
            "inicio": "09:00",
            "fim": "18:00"
          },
          "sex": {
            "ativo": true,
            "inicio": "09:00",
            "fim": "18:00"
          },
          "sab": {
            "ativo": false,
            "inicio": "09:00",
            "fim": "13:00"
          },
          "dom": {
            "ativo": false,
            "inicio": "09:00",
            "fim": "13:00"
          }
        },
        "mensagem_offline": "Estamos fora do hor\u00e1rio de atendimento. Deixe sua mensagem que responderemos em breve!"
      },
      "description": "Configura\u00e7\u00e3o de hor\u00e1rio de atendimento"
    },
    "ia_ativa": {
      "type": "boolean",
      "default": false,
      "description": "Auto-resposta IA habilitada (requer cr\u00e9ditos)"
    },
    "agente_ia_id": {
      "type": "string",
      "description": "ID do AgenteIAClinica vinculado"
    },
    "limite_diario_ia": {
      "type": "number",
      "default": 100,
      "description": "Limite di\u00e1rio de perguntas IA (anti-abuso)"
    },
    "formulario_contato": {
      "type": "boolean",
      "default": true,
      "description": "Solicitar dados pr\u00e9-chat obrigat\u00f3rio"
    },
    "permitir_anexos": {
      "type": "boolean",
      "default": true,
      "description": "Permitir anexos nas mensagens"
    },
    "mostrar_indicador_escrita": {
      "type": "boolean",
      "default": true,
      "description": "Mostrar 'digitando...'"
    },
    "notificacao_navegador": {
      "type": "boolean",
      "default": false,
      "description": "Notifica\u00e7\u00f5es push no navegador"
    },
    "som_notificacao": {
      "type": "boolean",
      "default": true,
      "description": "Som ao receber mensagem"
    },
    "posicao_widget": {
      "type": "string",
      "enum": [
        "inferior_direito",
        "inferior_esquerdo",
        "superior_direito",
        "superior_esquerdo"
      ],
      "default": "inferior_direito",
      "description": "Posi\u00e7\u00e3o do widget (PADR\u00c3O: inferior_direito)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Widget ativo"
    }
  },
  "required": [
    "clinica_id"
  ],
  "indexes": [
    {
      "fields": [
        "clinica_id"
      ],
      "name": "idx_widget_clinica",
      "unique": true
    }
  ]
}