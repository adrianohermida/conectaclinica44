{
  "name": "SecretConector",
  "type": "object",
  "properties": {
    "conector_id": {
      "type": "string",
      "description": "ID do conector"
    },
    "conector_nome": {
      "type": "string",
      "description": "Nome do conector"
    },
    "chave": {
      "type": "string",
      "description": "Nome da chave secreta (ex: API_KEY)"
    },
    "valor_criptografado": {
      "type": "string",
      "description": "Valor criptografado do secret"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do secret"
    },
    "data_expiracao": {
      "type": "string",
      "format": "date",
      "description": "Data de expira\u00e7\u00e3o do secret"
    },
    "ultima_rotacao": {
      "type": "string",
      "format": "date",
      "description": "\u00daltima rota\u00e7\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o secret est\u00e1 ativo"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "development",
        "production"
      ],
      "default": "production",
      "description": "Ambiente"
    }
  },
  "required": [
    "conector_id",
    "chave",
    "valor_criptografado"
  ]
}