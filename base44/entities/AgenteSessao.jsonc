{
  "name": "AgenteSessao",
  "type": "object",
  "properties": {
    "agente_id": {
      "type": "string",
      "description": "ID do agente (qa_tester, ux_validator, etc)"
    },
    "ativo": {
      "type": "boolean",
      "default": false,
      "description": "Agente est\u00e1 ativo/monitorando"
    },
    "conversacao_id": {
      "type": "string",
      "description": "ID da conversa\u00e7\u00e3o ativa do agente"
    },
    "ultima_ativacao": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima vez que foi ativado"
    },
    "total_interacoes": {
      "type": "number",
      "default": 0,
      "description": "Total de intera\u00e7\u00f5es realizadas"
    },
    "achados_criticos": {
      "type": "number",
      "default": 0,
      "description": "Bugs/issues cr\u00edticos encontrados"
    },
    "configuracao": {
      "type": "object",
      "properties": {
        "auto_scan": {
          "type": "boolean",
          "default": false
        },
        "intervalo_minutos": {
          "type": "number",
          "default": 60
        }
      }
    }
  },
  "required": [
    "agente_id"
  ]
}