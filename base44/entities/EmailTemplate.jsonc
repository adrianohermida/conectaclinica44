{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "clinica_id": {
      "type": "string",
      "description": "ID da cl\u00ednica"
    },
    "nome": {
      "type": "string",
      "description": "Nome do template"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "lembrete_consulta",
        "confirmacao_agendamento",
        "cancelamento",
        "reagendamento",
        "pos_consulta",
        "boas_vindas",
        "custom"
      ],
      "description": "Tipo de template"
    },
    "assunto": {
      "type": "string",
      "description": "Assunto do email"
    },
    "corpo_html": {
      "type": "string",
      "description": "Corpo do email em HTML"
    },
    "corpo_texto": {
      "type": "string",
      "description": "Corpo do email em texto plano (fallback)"
    },
    "variaveis_disponiveis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vari\u00e1veis que podem ser usadas: {{paciente_nome}}, {{medico_nome}}, {{data}}, {{horario}}, {{clinica_nome}}, {{tipo_consulta}}, {{especialidade}}"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Template ativo"
    },
    "padrao": {
      "type": "boolean",
      "default": false,
      "description": "Template padr\u00e3o do sistema"
    }
  },
  "required": [
    "clinica_id",
    "nome",
    "tipo",
    "assunto",
    "corpo_html"
  ]
}