{
  "name": "ObrigacaoFiscal",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da obriga\u00e7\u00e3o"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "fiscal",
        "contabil",
        "trabalhista",
        "previdenciaria",
        "acessoria"
      ],
      "description": "Tipo da obriga\u00e7\u00e3o"
    },
    "esfera": {
      "type": "string",
      "enum": [
        "federal",
        "estadual",
        "municipal"
      ],
      "description": "Esfera governamental"
    },
    "periodicidade": {
      "type": "string",
      "enum": [
        "diaria",
        "semanal",
        "quinzenal",
        "mensal",
        "trimestral",
        "semestral",
        "anual",
        "eventual"
      ],
      "description": "Periodicidade"
    },
    "dia_vencimento": {
      "type": "number",
      "description": "Dia do vencimento no per\u00edodo"
    },
    "mes_referencia": {
      "type": "string",
      "description": "M\u00eas de refer\u00eancia (para anuais)"
    },
    "sistema_envio": {
      "type": "string",
      "description": "Sistema utilizado para envio"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pela obriga\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "multa_atraso": {
      "type": "string",
      "description": "Informa\u00e7\u00f5es sobre multa por atraso"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 ativo"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "nome",
    "tipo",
    "esfera",
    "periodicidade"
  ]
}