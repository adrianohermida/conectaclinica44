{
  "name": "PlanoDeTratamento",
  "type": "object",
  "properties": {
    "paciente_id": {
      "type": "string",
      "description": "ID do paciente"
    },
    "paciente_nome": {
      "type": "string",
      "description": "Nome do paciente"
    },
    "medico_id": {
      "type": "string",
      "description": "ID do m\u00e9dico respons\u00e1vel"
    },
    "medico_nome": {
      "type": "string",
      "description": "Nome do m\u00e9dico"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do plano de tratamento"
    },
    "diagnostico": {
      "type": "string",
      "description": "Diagn\u00f3stico principal"
    },
    "objetivos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Objetivos do tratamento"
    },
    "tratamentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "frequencia": {
            "type": "string"
          },
          "duracao_prevista": {
            "type": "string"
          },
          "profissional_responsavel": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "planejado",
              "em_andamento",
              "concluido",
              "cancelado"
            ]
          }
        }
      },
      "description": "Lista de tratamentos do plano"
    },
    "medicamentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "dosagem": {
            "type": "string"
          },
          "frequencia": {
            "type": "string"
          },
          "duracao": {
            "type": "string"
          },
          "orientacoes": {
            "type": "string"
          }
        }
      },
      "description": "Medicamentos prescritos"
    },
    "exames_solicitados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Exames solicitados"
    },
    "orientacoes_gerais": {
      "type": "string",
      "description": "Orienta\u00e7\u00f5es gerais ao paciente"
    },
    "restricoes": {
      "type": "string",
      "description": "Restri\u00e7\u00f5es e contraindica\u00e7\u00f5es"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do tratamento"
    },
    "data_fim_prevista": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de t\u00e9rmino"
    },
    "proxima_revisao": {
      "type": "string",
      "format": "date",
      "description": "Data da pr\u00f3xima revis\u00e3o do plano"
    },
    "valor_total_estimado": {
      "type": "number",
      "description": "Valor total estimado do tratamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposta",
        "aprovado",
        "em_andamento",
        "pausado",
        "concluido",
        "cancelado"
      ],
      "default": "proposta",
      "description": "Status do plano"
    },
    "progresso": {
      "type": "number",
      "description": "Progresso do tratamento (%)"
    },
    "acompanhamentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date"
          },
          "observacao": {
            "type": "string"
          },
          "profissional": {
            "type": "string"
          },
          "evolucao": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de acompanhamentos"
    },
    "arquivos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Arquivos anexados"
    }
  },
  "required": [
    "paciente_id",
    "paciente_nome",
    "medico_nome",
    "titulo",
    "diagnostico"
  ]
}