{
  "name": "Clinica",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da cl\u00ednica"
    },
    "slug": {
      "type": "string",
      "description": "Slug \u00fanico da cl\u00ednica (URL-friendly, usado para alias de email)"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone principal"
    },
    "email": {
      "type": "string",
      "description": "Email de contato"
    },
    "endereco": {
      "type": "object",
      "properties": {
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "complemento": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "uf": {
          "type": "string"
        },
        "cep": {
          "type": "string"
        }
      }
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo"
    },
    "avatar_url": {
      "type": "string",
      "description": "Avatar para agenda p\u00fablica"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o para agenda p\u00fablica"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "inativa",
        "trial",
        "cancelada"
      ],
      "default": "trial"
    },
    "data_ativacao": {
      "type": "string",
      "format": "date"
    },
    "plano_atual": {
      "type": "string",
      "enum": [
        "starter",
        "profissional",
        "enterprise"
      ],
      "default": "starter"
    }
  },
  "required": [
    "nome"
  ],
  "indexes": [
    {
      "fields": [
        "cnpj"
      ],
      "name": "idx_clinica_cnpj",
      "unique": true,
      "sparse": true
    },
    {
      "fields": [
        "slug"
      ],
      "name": "idx_clinica_slug",
      "unique": true,
      "sparse": true
    }
  ]
}