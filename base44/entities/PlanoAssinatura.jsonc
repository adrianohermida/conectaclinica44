{
  "name": "PlanoAssinatura",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do plano"
    },
    "slug": {
      "type": "string",
      "description": "Identificador \u00fanico"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do plano"
    },
    "preco_mensal": {
      "type": "number",
      "description": "Pre\u00e7o mensal (R$)"
    },
    "preco_anual": {
      "type": "number",
      "description": "Pre\u00e7o anual (R$)"
    },
    "stripe_price_id_mensal": {
      "type": "string",
      "description": "Stripe Price ID para cobran\u00e7a mensal"
    },
    "stripe_price_id_anual": {
      "type": "string",
      "description": "Stripe Price ID para cobran\u00e7a anual"
    },
    "desconto_anual_percentual": {
      "type": "number",
      "description": "Desconto se pagar anual (%)"
    },
    "limites": {
      "type": "object",
      "properties": {
        "max_usuarios": {
          "type": "number"
        },
        "max_pacientes": {
          "type": "number"
        },
        "max_agendamentos_mes": {
          "type": "number"
        },
        "telemedicina": {
          "type": "boolean"
        },
        "ia_assistida": {
          "type": "boolean"
        },
        "storage_gb": {
          "type": "number"
        },
        "suporte": {
          "type": "string"
        }
      },
      "description": "Limites do plano"
    },
    "recursos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de recursos inclusos"
    },
    "ordem_exibicao": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "popular": {
      "type": "boolean",
      "default": false,
      "description": "Plano mais popular"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Plano ativo"
    }
  },
  "required": [
    "nome",
    "slug",
    "preco_mensal"
  ]
}