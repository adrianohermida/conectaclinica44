{
  "name": "ResultadoAPICompleto",
  "type": "object",
  "properties": {
    "tipo_consulta": {
      "type": "string",
      "enum": [
        "fgts",
        "receita_federal",
        "trt11",
        "tcu",
        "prefeitura",
        "sefaz"
      ],
      "description": "Tipo de consulta realizada"
    },
    "parametros_enviados": {
      "type": "object",
      "description": "Par\u00e2metros enviados para a API"
    },
    "resposta_completa": {
      "type": "object",
      "description": "Resposta completa da API em JSON"
    },
    "sucesso": {
      "type": "boolean",
      "description": "Se a consulta foi bem sucedida"
    },
    "codigo_retorno": {
      "type": "number",
      "description": "C\u00f3digo de retorno da API"
    },
    "tempo_resposta_ms": {
      "type": "number",
      "description": "Tempo de resposta em milissegundos"
    },
    "custo_api": {
      "type": "string",
      "description": "Custo da consulta"
    },
    "certidao_gerada_id": {
      "type": "string",
      "description": "ID da certid\u00e3o gerada no sistema"
    },
    "usuario_solicitante": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio que fez a consulta"
    }
  },
  "required": [
    "tipo_consulta",
    "resposta_completa",
    "sucesso"
  ]
}