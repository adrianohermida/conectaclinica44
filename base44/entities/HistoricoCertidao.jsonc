{
  "name": "HistoricoCertidao",
  "type": "object",
  "properties": {
    "certidao_id": {
      "type": "string",
      "description": "ID da certid\u00e3o relacionada"
    },
    "certidao_titulo": {
      "type": "string",
      "description": "T\u00edtulo da certid\u00e3o"
    },
    "orgao_emissor": {
      "type": "string",
      "description": "\u00d3rg\u00e3o emissor"
    },
    "data_emissao": {
      "type": "string",
      "format": "date",
      "description": "Data de emiss\u00e3o"
    },
    "data_validade": {
      "type": "string",
      "format": "date",
      "description": "Data de validade"
    },
    "numero_certidao": {
      "type": "string",
      "description": "N\u00famero da certid\u00e3o"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "negativa",
        "positiva",
        "positiva_com_efeito_negativa",
        "nada_consta"
      ],
      "description": "Resultado"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL do arquivo"
    },
    "tipo_registro": {
      "type": "string",
      "enum": [
        "emissao",
        "renovacao",
        "consulta_automatica",
        "consulta_manual"
      ],
      "description": "Tipo do registro"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "certidao_titulo",
    "orgao_emissor",
    "tipo_registro"
  ]
}