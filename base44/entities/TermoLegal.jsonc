{
  "name": "TermoLegal",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "cfm_normas",
        "lgpd_termo",
        "codigo_etica",
        "cdc_direitos",
        "termo_uso",
        "politica_privacidade",
        "outro"
      ],
      "description": "Tipo de termo legal"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do termo"
    },
    "conteudo_html": {
      "type": "string",
      "description": "Conte\u00fado completo em HTML (editor rich text)"
    },
    "conteudo_markdown": {
      "type": "string",
      "description": "Backup em markdown"
    },
    "versao": {
      "type": "string",
      "description": "Vers\u00e3o do termo (ex: 1.0, 2.1)"
    },
    "hash_sha256": {
      "type": "string",
      "description": "Hash SHA-256 do conte\u00fado para integridade"
    },
    "modulo_aplicacao": {
      "type": "string",
      "enum": [
        "dashboard",
        "prontuarios",
        "atendimento",
        "financeiro",
        "telemedicina",
        "global"
      ],
      "description": "M\u00f3dulo onde ser\u00e1 exibido"
    },
    "obrigatorio": {
      "type": "boolean",
      "default": true,
      "description": "Aceite obrigat\u00f3rio"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Vers\u00e3o ativa"
    },
    "data_vigencia": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio de vig\u00eancia"
    },
    "data_fim_vigencia": {
      "type": "string",
      "format": "date",
      "description": "Data de fim de vig\u00eancia (opcional)"
    },
    "autor_criacao": {
      "type": "string",
      "description": "Autor respons\u00e1vel"
    },
    "metadata": {
      "type": "object",
      "description": "Metadados adicionais"
    }
  },
  "required": [
    "tipo",
    "titulo",
    "conteudo_html",
    "versao",
    "hash_sha256"
  ]
}