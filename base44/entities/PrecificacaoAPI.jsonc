{
  "name": "PrecificacaoAPI",
  "type": "object",
  "properties": {
    "conector_id": {
      "type": "string",
      "description": "ID do conector"
    },
    "conector_nome": {
      "type": "string",
      "description": "Nome do conector"
    },
    "periodo": {
      "type": "string",
      "description": "Per\u00edodo de refer\u00eancia (ex: 2025-01)"
    },
    "total_consultas": {
      "type": "number",
      "description": "Total de consultas no per\u00edodo"
    },
    "consultas_sucesso": {
      "type": "number",
      "description": "Consultas bem-sucedidas"
    },
    "consultas_erro": {
      "type": "number",
      "description": "Consultas com erro"
    },
    "preco_unitario": {
      "type": "number",
      "description": "Pre\u00e7o unit\u00e1rio por consulta (R$)"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total no per\u00edodo (R$)"
    },
    "custo_medio_dia": {
      "type": "number",
      "description": "Custo m\u00e9dio por dia (R$)"
    },
    "limite_orcamento": {
      "type": "number",
      "description": "Limite de or\u00e7amento mensal (R$)"
    },
    "percentual_orcamento": {
      "type": "number",
      "description": "Percentual do or\u00e7amento usado (%)"
    },
    "projecao_fim_mes": {
      "type": "number",
      "description": "Proje\u00e7\u00e3o de custo para fim do m\u00eas (R$)"
    },
    "economia_estimada": {
      "type": "number",
      "description": "Economia com cache/otimiza\u00e7\u00e3o (R$)"
    },
    "detalhamento": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string"
          },
          "consultas": {
            "type": "number"
          },
          "custo": {
            "type": "number"
          }
        }
      },
      "description": "Detalhamento di\u00e1rio"
    }
  },
  "required": [
    "conector_id",
    "periodo",
    "total_consultas"
  ]
}