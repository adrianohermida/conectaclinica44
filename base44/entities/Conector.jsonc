{
  "name": "Conector",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do conector (ex: FGTS, Receita Federal)"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico (ex: fgts, receita_federal)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "infosimples",
        "custom",
        "webhook"
      ],
      "description": "Tipo de conector"
    },
    "endpoint_base": {
      "type": "string",
      "description": "URL base da API"
    },
    "metodo_http": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "default": "POST",
      "description": "M\u00e9todo HTTP padr\u00e3o"
    },
    "headers_padrao": {
      "type": "object",
      "description": "Headers HTTP padr\u00e3o"
    },
    "parametros_entrada": {
      "type": "object",
      "description": "Schema JSON dos par\u00e2metros de entrada"
    },
    "schema_resposta": {
      "type": "object",
      "description": "Schema JSON da resposta esperada"
    },
    "mapeamento_campos": {
      "type": "object",
      "properties": {
        "numero_certidao": {
          "type": "string"
        },
        "data_emissao": {
          "type": "string"
        },
        "data_validade": {
          "type": "string"
        },
        "situacao": {
          "type": "string"
        },
        "pdf_url": {
          "type": "string"
        }
      },
      "description": "Mapeamento de campos da resposta para certid\u00e3o"
    },
    "preco_consulta": {
      "type": "number",
      "description": "Pre\u00e7o unit\u00e1rio por consulta (R$)"
    },
    "limite_consultas_mes": {
      "type": "number",
      "description": "Limite de consultas por m\u00eas"
    },
    "timeout_segundos": {
      "type": "number",
      "default": 30,
      "description": "Timeout em segundos"
    },
    "retry_tentativas": {
      "type": "number",
      "default": 3,
      "description": "Tentativas de retry"
    },
    "url_documentacao": {
      "type": "string",
      "description": "URL da documenta\u00e7\u00e3o oficial"
    },
    "url_manual": {
      "type": "string",
      "description": "URL para consulta manual"
    },
    "entidade_destino": {
      "type": "string",
      "description": "Entidade que receber\u00e1 o resultado"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o conector est\u00e1 ativo"
    },
    "requer_autenticacao": {
      "type": "boolean",
      "default": true,
      "description": "Se requer autentica\u00e7\u00e3o"
    },
    "tipo_autenticacao": {
      "type": "string",
      "enum": [
        "api_key",
        "bearer",
        "basic",
        "oauth2",
        "custom"
      ],
      "description": "Tipo de autentica\u00e7\u00e3o"
    },
    "secrets_necessarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de secrets necess\u00e1rios"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para categoriza\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es e notas"
    }
  },
  "required": [
    "nome",
    "codigo",
    "tipo"
  ]
}