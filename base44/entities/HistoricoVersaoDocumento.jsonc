{
  "name": "HistoricoVersaoDocumento",
  "type": "object",
  "properties": {
    "documento_id": {
      "type": "string",
      "description": "ID do documento original"
    },
    "numero_versao": {
      "type": "number",
      "description": "N\u00famero da vers\u00e3o (1, 2, 3...)"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo naquela vers\u00e3o"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL do arquivo (snapshot)"
    },
    "tipo_arquivo": {
      "type": "string",
      "description": "Extens\u00e3o do arquivo"
    },
    "tamanho_bytes": {
      "type": "number",
      "description": "Tamanho em bytes"
    },
    "hash_sha256": {
      "type": "string",
      "description": "Hash SHA-256 do conte\u00fado"
    },
    "tipo_alteracao": {
      "type": "string",
      "enum": [
        "criacao",
        "edicao_conteudo",
        "edicao_metadata",
        "substituicao_arquivo"
      ],
      "description": "Tipo de altera\u00e7\u00e3o"
    },
    "alterado_por": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "alterado_por_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "observacao": {
      "type": "string",
      "description": "Motivo da altera\u00e7\u00e3o (opcional)"
    }
  },
  "required": [
    "documento_id",
    "numero_versao",
    "titulo",
    "arquivo_url"
  ],
  "indexes": [
    {
      "fields": [
        "documento_id",
        "-numero_versao"
      ],
      "name": "idx_historico_timeline"
    },
    {
      "fields": [
        "documento_id",
        "numero_versao"
      ],
      "name": "idx_historico_versao_unique",
      "unique": true
    }
  ]
}